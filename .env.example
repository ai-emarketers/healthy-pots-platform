# Copy to apps/api/.env and apps/web/.env.local (values below work for local development)

# ---- API (apps/api/.env) ----
DATABASE_URL="postgresql://healthypots:healthypots@localhost:5432/healthypots?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# dev: OTP is always 123456 and is returned by the API. prod: wire an SMS provider in AuthService.sendOtp
# off = no OTP, mobile number alone logs in (development only). dev = fixed OTP 123456. prod = real SMS.
OTP_MODE=dev
# mock: customers can confirm payment from the app (demo). shopify: only the Shopify webhook activates subscriptions
PAYMENT_MODE=mock
SHOPIFY_WEBHOOK_SECRET=""

# ---- Web (apps/web/.env.local) ----
API_URL="http://localhost:4000"
# must equal the API JWT_SECRET: the Next.js middleware verifies the role from the same cookie
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
DELIVERY_WEBHOOK_SECRET=""
